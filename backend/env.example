# Ambiente
NODE_ENV=development
PORT=3001

# Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=canal_ouvidoria
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT (gerar chaves com: ssh-keygen -t rsa -b 4096)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Magic Link
MAGIC_LINK_EXPIRATION=15m
MAGIC_LINK_RATE_LIMIT_EMAIL=3
MAGIC_LINK_RATE_LIMIT_IP=10

# Frontend URL
FRONTEND_URL=http://localhost:3002

# Email (configurar conforme provedor)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@ouvidoria.com

# Storage
STORAGE_TYPE=local
STORAGE_PATH=./uploads
STORAGE_MAX_FILE_SIZE=26214400
STORAGE_MAX_TOTAL_SIZE=104857600

# Rate Limiting
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_RELATOS_MAX=10

# Segurança
BCRYPT_ROUNDS=12
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Logs
LOG_LEVEL=info
LOG_PRETTY=true



